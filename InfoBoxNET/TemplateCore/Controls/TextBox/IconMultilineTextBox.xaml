<UserControl
    x:Class="System.Windows.Controls.IconMultilineTextBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:System.Windows.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    MinWidth="200"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    mc:Ignorable="d">
    <UserControl.Resources>

        <!--  Mehrzeilige TextBox ohne eigenen Rahmen  -->
        <Style x:Key="InnerTextBoxStyle" TargetType="{x:Type TextBox}">

            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="AcceptsTab" Value="True" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <ScrollViewer
                            x:Name="PART_ContentHost"
                            Background="Transparent"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border
        x:Name="Container"
        MinHeight="30"
        Padding="10,6"
        Background="White"
        BorderThickness="1"
        CornerRadius="4"
        SnapsToDevicePixels="True">

        <Border.Style>
            <Style TargetType="{x:Type Border}">
                <Setter Property="BorderBrush" Value="#D1D1D1" />

                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="#8A8A8A" />
                    </Trigger>

                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=Root}" Value="True">
                        <Setter Property="BorderBrush" Value="#0067C0" />
                        <Setter Property="BorderThickness" Value="2" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid ColumnDefinitions="28,5,3,12,*" ShowGridLines="False">

            <!--  Symbolbereich mit konfigurierbarer Hintergrundfarbe  -->
            <Border
                Grid.Column="0"
                VerticalAlignment="Stretch"
                Background="{Binding IconBackground, ElementName=Root}"
                CornerRadius="3">

                <Grid
                    Width="30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ShowGridLines="False">

                    <!--  Icon  -->
                    <Image
                        x:Name="IconImage"
                        Width="30"
                        Height="30"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Source="{Binding Icon, ElementName=Root}"
                        Stretch="Uniform">

                        <Image.Style>
                            <Style TargetType="{x:Type Image}">
                                <Setter Property="Visibility" Value="Visible" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Icon, ElementName=Root}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>

                    <!--  Standardsymbol T  -->
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="Gray"
                        Text="T">

                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Icon, ElementName=Root}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>

                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!--  Abstand vor dem Trennstrich  -->
            <Border Grid.Column="1" />

            <!--  Vertikaler Trennstrich  -->
            <Border
                x:Name="Separator"
                Grid.Column="2"
                Width="1"
                Margin="0,2"
                VerticalAlignment="Stretch"
                Background="Gray" />

            <!--  Abstand nach dem Trennstrich  -->
            <Border Grid.Column="3" />

            <!--  Texteingabe und Wasserzeichen  -->
            <Grid Grid.Column="4">
                <TextBox
                    x:Name="PART_TextBox"
                    Padding="0,0,0,20"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Top"
                    CaretBrush="{Binding Foreground, RelativeSource={RelativeSource Self}}"
                    MaxLength="{Binding MaxLength, ElementName=Root}"
                    MaxLines="{Binding VisibleLines, ElementName=Root}"
                    MinLines="{Binding VisibleLines, ElementName=Root}"
                    Style="{StaticResource InnerTextBoxStyle}"
                    Text="{Binding Text, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!--  Wasserzeichen  -->
                <TextBlock
                    x:Name="WatermarkText"
                    Margin="0,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="{Binding WatermarkForeground, ElementName=Root}"
                    IsHitTestVisible="False"
                    Text="{Binding Watermark, ElementName=Root}"
                    TextTrimming="CharacterEllipsis">

                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Collapsed" />

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=PART_TextBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>

                                <DataTrigger Binding="{Binding Text, ElementName=PART_TextBox}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!--  Zeichenanzeige unten rechts  -->
                <TextBlock
                    Margin="0,0,2,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="White"
                    FontSize="11"
                    Foreground="Gray"
                    IsHitTestVisible="False">

                    <Run Text="{Binding MaxLength, ElementName=Root, Mode=OneWay}" />
                    <Run Text="/" />
                    <Run Text="{Binding CharacterCount, ElementName=Root, Mode=OneWay}" />
                </TextBlock>
            </Grid>
        </Grid>
    </Border>
</UserControl>
