<UserControl
    x:Class="System.Windows.Controls.IconPasswordTextBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:System.Windows.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    MinHeight="48"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    mc:Ignorable="d">
    <UserControl.Resources>

        <Style x:Key="PasswordInputStyle" TargetType="{x:Type PasswordBox}">

            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#202020" />
            <Setter Property="VerticalContentAlignment" Value="Center" />

        </Style>

        <Style x:Key="VisiblePasswordStyle" TargetType="{x:Type TextBox}">

            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#202020" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />

        </Style>

        <Style x:Key="VisibilityButtonStyle" TargetType="{x:Type Button}">

            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#606060" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Focusable" Value="False" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EEEEEE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

    </UserControl.Resources>

    <StackPanel>

        <!--  Eingabefeld  -->
        <Border
            x:Name="Container"
            MinHeight="44"
            Padding="12,0"
            Background="White"
            BorderBrush="#D1D1D1"
            BorderThickness="1"
            CornerRadius="6">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>

                <!--  Icon  -->
                <Grid
                    Grid.Column="0"
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center">

                    <Image Source="{Binding Icon, ElementName=Root}" Stretch="Uniform">

                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Visible" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Icon, ElementName=Root}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>

                    </Image>

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Foreground="#606060"
                        Text="T">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Icon, ElementName=Root}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>

                    </TextBlock>

                </Grid>

                <!--  Trennstrich  -->
                <Border
                    Grid.Column="2"
                    Width="1"
                    Margin="0,9"
                    Background="#D1D1D1" />

                <!--  Passwort und Wasserzeichen  -->
                <Grid Grid.Column="4" VerticalAlignment="Stretch">

                    <!--  Maskierte Eingabe  -->
                    <PasswordBox
                        x:Name="PART_PasswordBox"
                        VerticalContentAlignment="Center"
                        PasswordChanged="PasswordBox_PasswordChanged"
                        PasswordChar="{Binding PasswordChar, ElementName=Root}"
                        Style="{StaticResource PasswordInputStyle}"
                        Visibility="Visible" />

                    <!--  Klartexteingabe  -->
                    <TextBox
                        x:Name="PART_TextBox"
                        VerticalContentAlignment="Center"
                        Style="{StaticResource VisiblePasswordStyle}"
                        Text="{Binding Password, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="Collapsed" />

                    <!--  Wasserzeichen  -->
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="{Binding WatermarkForeground, ElementName=Root}"
                        IsHitTestVisible="False"
                        Text="{Binding Watermark, ElementName=Root}">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Password, ElementName=Root}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Password, ElementName=Root}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>

                    </TextBlock>

                </Grid>

                <!--  Abstand vor Button  -->
                <Border Grid.Column="5" />

                <!--  Passwort anzeigen / verbergen  -->
                <Button
                    x:Name="PART_ToggleButton"
                    Grid.Column="6"
                    Click="TogglePasswordVisibility_Click"
                    Content="◉"
                    Style="{StaticResource VisibilityButtonStyle}"
                    ToolTip="Passwort anzeigen" />

            </Grid>

        </Border>

        <!--  Passwortqualität  -->
        <Border
            x:Name="StrengthBar"
            Height="3"
            Margin="4,2,4,0"
            Background="{Binding PasswordStrengthBrush, ElementName=Root}"
            CornerRadius="2" />

    </StackPanel>
</UserControl>
