<UserControl
    x:Class="System.Windows.Controls.ImageBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="100"
    MinHeight="100"
    Background="Transparent">

    <UserControl.Resources>

        <!--  Windows 11 angelehnter Menü-Stil  -->
        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        </Style>

        <Style TargetType="{x:Type Separator}">
            <Setter Property="Margin" Value="8,4" />
        </Style>

    </UserControl.Resources>

    <Border
        x:Name="MainBorder"
        Padding="5"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        BorderBrush="#FFD5D5D5"
        BorderThickness="1"
        CornerRadius="10"
        SnapsToDevicePixels="True">

        <Border.ContextMenu>
            <ContextMenu x:Name="ImageContextMenu" Opened="ImageContextMenu_Opening">

                <MenuItem Click="Remove_Click" Header="Entfernen">
                    <MenuItem.Icon>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" />
                    </MenuItem.Icon>
                </MenuItem>

                <Separator />

                <MenuItem
                    x:Name="PasteMenuItem"
                    Click="Paste_Click"
                    Header="Aus Zwischenablage einfügen">
                    <MenuItem.Icon>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77F;" />
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem
                    x:Name="CopyMenuItem"
                    Click="Copy_Click"
                    Header="In Zwischenablage kopieren">
                    <MenuItem.Icon>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C8;" />
                    </MenuItem.Icon>
                </MenuItem>

                <Separator />

                <MenuItem
                    x:Name="LoadFileMenuItem"
                    Click="LoadFile_Click"
                    Header="Bild aus Datei laden...">
                    <MenuItem.Icon>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" />
                    </MenuItem.Icon>
                </MenuItem>

            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <!--  Bild bzw. Symbol  -->
            <Image
                x:Name="DisplayImage"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Stretch="Uniform" />

            <!--  Platzhalter  -->
            <TextBlock
                x:Name="Placeholder"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="#FF999999"
                IsHitTestVisible="False"
                Text="Bild oder Symbol" />
        </Grid>

    </Border>
</UserControl>