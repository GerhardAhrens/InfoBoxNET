<base:UserControlBase
    x:Class="InfoBoxNET.View.PasswordsUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:UI="clr-namespace:System.Windows.Controls"
    xmlns:base="clr-namespace:System.Windows"
    xmlns:core="clr-namespace:InfoBoxNET.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:InfoBoxNET.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid
        x:Name="gridMain"
        Background="WhiteSmoke"
        ColumnDefinitions="*"
        RowDefinitions="Auto,*">

        <!--#region Hauptmenübar-->
        <UI:MenuBar
            Grid.Row="0"
            Grid.ColumnSpan="2"
            ButtonSpacing="5"
            Header="Passort / Lizenzen"
            ItemPadding="8,2"
            ShowBorder="True">

            <UI:MenuButton
                Command="{Binding Path=GoBackCommand}"
                CommandParameter="{x:Static core:CommandButtons.GoBack}"
                Image="{StaticResource ResourceKey=IconGoBack}"
                ToolTipText="Zurück zum Hauptmenü" />

            <UI:MenuButton
                Command="{Binding Path=ImpExportPasswordsCommand}"
                CommandParameter="{x:Static core:CommandButtons.ImportExportPasswords}"
                Image="{StaticResource ResourceKey=ImportExportIcon}"
                ToolTip="Import / Export für Passwörter durchführen" />

        </UI:MenuBar>
        <!--#endregion Hauptmenübar-->

        <UI:AdvancedTabControl
            x:Name="ArtikelTabControl"
            Grid.Row="1"
            SelectionChangedCommand="{Binding Path=SelectionChangedCommand}">
            <UI:AdvancedTabControl.Resources>

                <Style TargetType="{x:Type TabItem}">
                    <!--  Fehler 1 Behebung: Das Tag-Property sauber initialisieren  -->
                    <Setter Property="Tag" Value="" />

                    <!--  Fehler 2 Behebung: Explizites Setter.Value hinzufügen  -->
                    <Setter Property="HeaderTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <!--  Grid ist jetzt sauber innerhalb des DataTemplates gekapselt  -->
                                <Grid Margin="2,0,2,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Register-Beschriftung  -->
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Text="{Binding}" />

                                    <!--  Schließen-Button  -->
                                    <Button
                                        Grid.Column="1"
                                        Width="16"
                                        Height="16"
                                        Padding="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Content="×"
                                        Cursor="Hand"
                                        FontSize="14"
                                        FontWeight="Bold">

                                        <Button.Command>
                                            <Binding Path="CloseTabCommand" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type UserControl}}" />
                                        </Button.Command>

                                        <Button.CommandParameter>
                                            <Binding RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type TabItem}}" />
                                        </Button.CommandParameter>

                                        <Button.Style>
                                            <Style TargetType="{x:Type Button}">
                                                <Setter Property="Foreground" Value="#FF7F7F7F" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="Red" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </UI:AdvancedTabControl.Resources>

            <UI:AdvancedTabItem Header="Passwörter / Lizenzen">
                <TextBlock
                    Margin="10"
                    FontSize="14"
                    Foreground="Black"
                    Text="Hier können Sie Ihre Passwörter und Lizenzen verwalten." />
            </UI:AdvancedTabItem>
        </UI:AdvancedTabControl>

    </Grid>
</base:UserControlBase>
