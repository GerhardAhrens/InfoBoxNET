<base:UserControlBase
    x:Class="InfoBoxNET.View.PasswordWEBDetailUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:UI="clr-namespace:System.Windows.Controls"
    xmlns:base="clr-namespace:System.Windows"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:InfoBoxNET.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid
        x:Name="gridMain"
        Background="Transparent"
        ColumnDefinitions="*,200"
        RowDefinitions="Auto,Auto,Auto,Auto,Auto, Auto,Auto">
        <UI:IconTextBox
            Grid.Row="0"
            Grid.Column="0"
            Height="30"
            Icon="{StaticResource ResourceKey=IconPageHeader}"
            KeyboardNavigation.IsTabStop="True"
            KeyboardNavigation.TabIndex="1"
            Text="{Binding Path=Title, UpdateSourceTrigger=PropertyChanged}" />

        <UI:WindowCheckBox
            Grid.Row="1"
            Grid.Column="0"
            Content="In der Übersicht anzeigen"
            FlowDirection="LeftToRight"
            FontWeight="Medium"
            IsChecked="{Binding Path=ShowDescription, UpdateSourceTrigger=PropertyChanged, FallbackValue=False}"
            KeyboardNavigation.IsTabStop="True"
            KeyboardNavigation.TabIndex="2" />

        <UI:IconMultilineTextBox
            Grid.Row="2"
            Icon="{StaticResource ResourceKey=IconSoftware_Note}"
            MaxLength="1000"
            Text="{Binding Path=Description, UpdateSourceTrigger=PropertyChanged}"
            VisibleLines="3"
            Watermark="Anmerkung und Notizen" />

        <UI:ListBoxImage
            x:Name="HorizontalImageList"
            Grid.Row="3"
            Grid.Column="0"
            Height="70"
            Margin="0,5,0,0"
            Focusable="True"
            ImageHeight="32"
            ImageStretch="UniformToFill"
            ImageWidth="32"
            ItemsSource="{Binding Path=SymbolSource}"
            Orientation="Horizontal"
            SymbolColor="Green">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <!--  Standard-Hintergrundfarbe für nicht selektierte Items  -->
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Padding" Value="4,2" />

                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <!--  Hier definieren wir den visuellen Rahmen selbst  -->
                                <Border
                                    x:Name="ListItemBorder"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter />
                                </Border>

                                <ControlTemplate.Triggers>
                                    <!--  Zustand 1: Das Item ist selektiert UND das Fenster/die Liste hat den Fokus  -->
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsSelected" Value="True" />
                                            <Condition Property="IsKeyboardFocusWithin" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="ListItemBorder" Property="Background" Value="DeepSkyBlue" />
                                        <Setter Property="Foreground" Value="White" />
                                    </MultiTrigger>

                                    <!--  Zustand 2: Das Item ist selektiert, aber die Liste hat KEINEN Fokus mehr  -->
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsSelected" Value="True" />
                                            <Condition Property="IsKeyboardFocusWithin" Value="False" />
                                        </MultiTrigger.Conditions>
                                        <!--  Hier setzen Sie Ihre Wunschfarbe für den inaktiven Zustand  -->
                                        <Setter TargetName="ListItemBorder" Property="Background" Value="#FFADD8E6" />
                                        <Setter Property="Foreground" Value="Black" />
                                    </MultiTrigger>

                                    <!--  Optional - Zustand 3: Maus fährt über das Item (Hover)  -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ListItemBorder" Property="Background" Value="#FFE0E0E0" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </UI:ListBoxImage>

        <TextBlock
            Grid.Row="3"
            Grid.Column="2"
            Width="100"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Text="{Binding Path=SelectedSymbol, FallbackValue=~SelectedSymbol}" />
    </Grid>
</base:UserControlBase>
