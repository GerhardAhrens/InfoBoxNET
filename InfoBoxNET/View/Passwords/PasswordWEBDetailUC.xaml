<base:UserControlBase
    x:Class="InfoBoxNET.View.PasswordWEBDetailUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:UI="clr-namespace:System.Windows.Controls"
    xmlns:base="clr-namespace:System.Windows"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:InfoBoxNET.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid
        x:Name="gridMain"
        Background="Transparent"
        ColumnDefinitions="*,200"
        RowDefinitions="Auto,Auto,Auto,Auto,Auto, Auto,Auto">
        <UI:IconTextBox
            Grid.Row="0"
            Grid.Column="0"
            KeyboardNavigation.IsTabStop="True"
            KeyboardNavigation.TabIndex="1"
            Text="{Binding Path=Title, UpdateSourceTrigger=PropertyChanged}" />

        <UI:WindowCheckBox
            Grid.Row="1"
            Grid.Column="0"
            Content="In der Übersicht anzeigen"
            FlowDirection="LeftToRight"
            FontWeight="Medium"
            IsChecked="{Binding Path=ShowDescription, UpdateSourceTrigger=PropertyChanged, FallbackValue=False}"
            KeyboardNavigation.IsTabStop="True"
            KeyboardNavigation.TabIndex="2" />

        <UI:IconTextBox
            Grid.Row="2"
            Grid.Column="0"
            Height="60"
            AcceptsReturn="True"
            KeyboardNavigation.IsTabStop="True"
            KeyboardNavigation.TabIndex="3"
            Text="{Binding Path=Description, UpdateSourceTrigger=PropertyChanged}" />

    </Grid>
</base:UserControlBase>
