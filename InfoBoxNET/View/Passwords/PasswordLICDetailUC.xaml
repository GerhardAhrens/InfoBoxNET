<base:UserControlBase
    x:Class="InfoBoxNET.View.PasswordLICDetailUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:UI="clr-namespace:System.Windows.Controls"
    xmlns:base="clr-namespace:System.Windows"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:InfoBoxNET.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid
        x:Name="gridMain"
        Background="Transparent"
        ColumnDefinitions="*,300"
        RowDefinitions="Auto,Auto,Auto,Auto,Auto, Auto,Auto,Auto,Auto,*">
        <UI:IconTextBox
            x:Name="TitelField"
            Grid.Row="0"
            Grid.Column="0"
            Height="30"
            Margin="0,5,0,0"
            Icon="{StaticResource ResourceKey=IconPageHeader}"
            IconBackground="Transparent"
            KeyboardNavigation.IsTabStop="True"
            KeyboardNavigation.TabIndex="1"
            Text="{Binding Path=CurrentRow.Title, UpdateSourceTrigger=PropertyChanged}"
            ToolTip="Titel eingeben" />

    </Grid>
</base:UserControlBase>
