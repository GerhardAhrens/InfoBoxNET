<base:UserControlBase
    x:Class="InfoBoxNET.View.PasswordsUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:UI="clr-namespace:System.Windows.Controls"
    xmlns:base="clr-namespace:System.Windows"
    xmlns:core="clr-namespace:InfoBoxNET.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:InfoBoxNET.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="RowNumberStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Foreground" Value="Green" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="0,0,6,0" />
        </Style>

        <UI:DrawingImageConverter x:Key="DrawingImageConverter" />
    </UserControl.Resources>

    <Grid
        x:Name="gridMain"
        Background="WhiteSmoke"
        ColumnDefinitions="*"
        RowDefinitions="Auto,*">

        <!--#region Hauptmenübar-->
        <UI:MenuBar
            Grid.Row="0"
            Grid.ColumnSpan="2"
            ButtonSpacing="5"
            Header="Passort / Lizenzen"
            ItemPadding="8,2"
            ShowBorder="True">

            <UI:MenuButton
                Command="{Binding Path=GoBackCommand}"
                CommandParameter="{x:Static core:CommandButtons.GoBack}"
                Image="{StaticResource ResourceKey=IconGoBack}"
                ToolTipText="Zurück zum Hauptmenü" />

            <UI:SplitButton
                Grid.Column="2"
                Height="40"
                Background="White"
                Command="{Binding Path=AddEntryCommand}"
                CommandParameter="ADD_WEB"
                Header="Neuer Eintrag"
                ItemsSource="{Binding Path=AddButtonItem}" />

            <UI:MenuButton
                Command="{Binding Path=CopyEntryCommand}"
                CommandParameter="{x:Static core:CommandButtons.CopyEntry}"
                Image="{StaticResource ResourceKey=IconCopyEntry}"
                ToolTip="Kopieren Eintrag" />

            <UI:MenuButton
                Command="{Binding Path=DeleteEntryCommand}"
                CommandParameter="{x:Static core:CommandButtons.DeleteEntry}"
                Image="{StaticResource ResourceKey=IconDeleteEntry}"
                ToolTip="Löschen Eintrag" />

            <UI:MenuButton
                Command="{Binding Path=ExportPasswordsCommand}"
                CommandParameter="{x:Static core:CommandButtons.ExportPasswords}"
                Image="{StaticResource ResourceKey=IconExcel}"
                ToolTip="Export für Passwörter/Lizenzen durchführen" />

            <UI:MenuButton
                Command="{Binding Path=PrintPasswordsCommand}"
                CommandParameter="{x:Static core:CommandButtons.PrintDocument}"
                Image="{StaticResource ResourceKey=IconPrintDocument}"
                ToolTip="Liste Drucken" />

            <UI:MenuButton
                Command="{Binding Path=ImpExportPasswordsCommand}"
                CommandParameter="{x:Static core:CommandButtons.ImportExportPasswords}"
                Image="{StaticResource ResourceKey=ImportExportIcon}"
                ToolTip="Import / Export für Passwörter durchführen" />
        </UI:MenuBar>
        <!--#endregion Hauptmenübar-->

        <UI:AdvancedTabControl
            x:Name="PasswordsTabControl"
            Grid.Row="1"
            SelectionChangedCommand="{Binding Path=SelectionChangedCommand}">
            <UI:AdvancedTabControl.Resources>

                <Style TargetType="{x:Type TabItem}">
                    <!--  Fehler 1 Behebung: Das Tag-Property sauber initialisieren  -->
                    <Setter Property="Tag" Value="" />

                    <!--  Fehler 2 Behebung: Explizites Setter.Value hinzufügen  -->
                    <Setter Property="HeaderTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <!--  Grid ist jetzt sauber innerhalb des DataTemplates gekapselt  -->
                                <Grid Margin="2,0,2,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Register-Beschriftung  -->
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Text="{Binding}" />

                                    <!--  Schließen-Button  -->
                                    <Button
                                        Grid.Column="1"
                                        Width="16"
                                        Height="16"
                                        Padding="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Content="×"
                                        Cursor="Hand"
                                        FontSize="14"
                                        FontWeight="Bold">

                                        <Button.Command>
                                            <Binding Path="CloseTabCommand" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type UserControl}}" />
                                        </Button.Command>

                                        <Button.CommandParameter>
                                            <Binding RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type TabItem}}" />
                                        </Button.CommandParameter>

                                        <Button.Style>
                                            <Style TargetType="{x:Type Button}">
                                                <Setter Property="Foreground" Value="#FF7F7F7F" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="Red" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </UI:AdvancedTabControl.Resources>

            <UI:AdvancedTabItem Header="Passwörter / Lizenzen Übersicht">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="100,*,Auto">
                        <TextBlock
                            Grid.Column="0"
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            Text="Filtern:" />
                        <UI:WindowTextBox Grid.Column="1" Text="{Binding Path=FilterDefaultSearch, UpdateSourceTrigger=PropertyChanged}" />
                        <UI:SplitButton
                            Grid.Column="2"
                            Command="{Binding Path=FilterButtonCommand}"
                            CommandParameter="FILTER_0"
                            Header="Alle Einträge"
                            ItemsSource="{Binding Path=FilterButtonItem}" />
                    </Grid>

                    <UI:AdvancedListView
                        x:Name="lvwMain"
                        Grid.Row="2"
                        Margin="0,5,0,0"
                        Background="WhiteSmoke"
                        DoubleClickCommand="{Binding Path=DoubleClickEntryCommand}"
                        ItemsSource="{Binding Path=DialogDataView}"
                        RowHeight="30"
                        RowNumberHeader="*"
                        RowNumberTextStyle="{StaticResource RowNumberStyle}"
                        SelectedItem="{Binding Path=CurrentSelectedItem, UpdateSourceTrigger=PropertyChanged}"
                        SelectedItemChangedCommand="{Binding Path=SelectEntryCommand}"
                        SelectionMode="Single"
                        ShowRowNumbers="True">
                        <ListView.View>
                            <GridView>
                                <UI:AdvancedImageColumn
                                    Header=""
                                    ImageBinding="{Binding Path=AccessSymbol, Converter={StaticResource DrawingImageConverter}}"
                                    ImageHeight="16"
                                    ImageToolTip="{Binding Path=Title}"
                                    ImageWidth="16" />

                                <UI:AdvancedGridViewColumn
                                    DisplayMemberBinding="{Binding Path=Title}"
                                    FilterType="Text"
                                    Header="Titel"
                                    SortMemberPath="Title" />

                                <UI:AdvancedGridViewColumn
                                    DisplayMemberBinding="{Binding Path=Username}"
                                    FilterType="Text"
                                    Header="Benutzername"
                                    SortMemberPath="Username" />

                                <UI:AdvancedGridViewColumn
                                    DisplayMemberBinding="{Binding Path=Website}"
                                    FilterType="Text"
                                    Header="Website"
                                    SortMemberPath="Website" />

                                <UI:AdvancedGridViewColumn
                                    DisplayMemberBinding="{Binding Path=Company}"
                                    FilterType="Text"
                                    Header="Firma"
                                    SortMemberPath="Company" />

                                <UI:AdvancedGridViewColumn
                                    DisplayMemberBinding="{Binding Path=Region}"
                                    FilterType="Text"
                                    Header="Region"
                                    SortMemberPath="Region" />
                            </GridView>
                        </ListView.View>
                    </UI:AdvancedListView>

                    <!--  Wird über der DataGrid dargestellt  -->
                    <UI:LoadingOverlay
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        IsActived="{Binding Path=IsLoadingOverlay, UpdateSourceTrigger=PropertyChanged}"
                        Text="Daten werden exportiert..." />
                </Grid>
            </UI:AdvancedTabItem>
        </UI:AdvancedTabControl>

    </Grid>
</base:UserControlBase>
