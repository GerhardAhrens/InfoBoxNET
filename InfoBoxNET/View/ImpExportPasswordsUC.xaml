<base:UserControlBase
    x:Class="InfoBoxNET.View.ImpExportPasswordsUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:UI="clr-namespace:System.Windows.Controls"
    xmlns:base="clr-namespace:System.Windows"
    xmlns:core="clr-namespace:InfoBoxNET.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:InfoBoxNET.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid
        x:Name="gridMain"
        Background="WhiteSmoke"
        ColumnDefinitions="*"
        RowDefinitions="Auto,*">

        <!--#region Hauptmenübar-->
        <GroupBox
            x:Name="MainMenubar"
            Grid.Row="0"
            Margin="5"
            Padding="5">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        CornerRadius="4">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </GroupBox.Template>
            <DockPanel Grid.Row="0" Grid.Column="0">
                <Button
                    Width="50"
                    Height="50"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Command="{Binding Path=GoBackCommand}"
                    CommandParameter="{x:Static core:CommandButtons.GoBack}"
                    ToolTip="Zurück">
                    <Image Source="{StaticResource ResourceKey=IconGoBack}" Stretch="Uniform" />
                </Button>
            </DockPanel>
        </GroupBox>
        <!--#endregion Hauptmenübar-->

        <Grid
            Grid.Row="1"
            ColumnDefinitions="*"
            RowDefinitions="*,*">
            <GroupBox
                Grid.Row="0"
                Grid.Column="0"
                Header="Export">
                <Grid ColumnDefinitions="110,*" RowDefinitions="10,Auto,auto, auto">
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Text="Alle Passwörter, Pin, usw. exportieren" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="0,10,0,0"
                        VerticalAlignment="Center"
                        Text="Exportverzeichnis" />

                    <UI:ChooseBox
                        Grid.Row="2"
                        Grid.Column="1"
                        Height="25"
                        Margin="0,10,0,0"
                        ChooseBoxType="Folder"
                        Text="{Binding Path=ExportFilename, FallbackValue=~ExportFilename}" />

                    <Button
                        Grid.Row="3"
                        Grid.Column="1"
                        Width="150"
                        Height="40"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        Command="{Binding Path=ExportCommand}"
                        CommandParameter="{x:Static core:CommandButtons.GoBack}"
                        ToolTip="Export starten">
                        <Grid ColumnDefinitions="45,*">
                            <Image
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                Source="{StaticResource ResourceKey=ExportJsonIcon}"
                                Stretch="Uniform" />
                            <TextBlock
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Text="Export starten" />
                        </Grid>
                    </Button>
                </Grid>
            </GroupBox>

            <GroupBox
                Grid.Row="1"
                Grid.Column="0"
                Header="Import">
                <Grid ColumnDefinitions="110,*" RowDefinitions="10,Auto,auto,auto">
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Text="Alle Passwörter, Pin, usw. importieren" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="Importverzeichnis" />

                    <UI:ChooseBox
                        Grid.Row="2"
                        Grid.Column="1"
                        Height="25"
                        Margin="0,10,0,0"
                        ChooseBoxType="Folder"
                        Text="{Binding Path=ImportFolder, FallbackValue=~ImportFolder}" />

                    <Button
                        Grid.Row="3"
                        Grid.Column="1"
                        Width="150"
                        Height="40"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        Command="{Binding Path=ImportCommand}"
                        CommandParameter="{x:Static core:CommandButtons.GoBack}"
                        ToolTip="Import starten">
                        <Grid ColumnDefinitions="45,*">
                            <Image
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                Source="{StaticResource ResourceKey=ImportJsonIcon}"
                                Stretch="Uniform" />
                            <TextBlock
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Text="Import starten" />
                        </Grid>
                    </Button>

                </Grid>
            </GroupBox>
        </Grid>

        <!--  Wird über der DataGrid dargestellt  -->
        <UI:ProgressOverlay
            Grid.Row="0"
            Grid.RowSpan="2"
            IsActived="{Binding Path=IsProgressOverlay, UpdateSourceTrigger=PropertyChanged}"
            MaxValue="100"
            MinValue="0"
            Text="{Binding Path=ProgressText, UpdateSourceTrigger=PropertyChanged}"
            Value="{Binding Path=ProgressValue, UpdateSourceTrigger=PropertyChanged}" />

    </Grid>
</base:UserControlBase>
