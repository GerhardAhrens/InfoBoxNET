<base:UserControlBase
    x:Class="InfoBoxNET.View.ReportingViewUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:UI="clr-namespace:System.Windows.Controls"
    xmlns:base="clr-namespace:System.Windows"
    xmlns:core="clr-namespace:InfoBoxNET.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:InfoBoxNET.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ControlTemplate x:Key="DocumentViewerNoToolbarTemplate" TargetType="{x:Type DocumentViewer}">
            <Border
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}">

                <ScrollViewer
                    x:Name="PART_ContentHost"
                    CanContentScroll="True"
                    Focusable="False"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto" />

            </Border>
        </ControlTemplate>
    </UserControl.Resources>

    <Grid
        x:Name="gridMain"
        Background="WhiteSmoke"
        ColumnDefinitions="*"
        RowDefinitions="Auto,*">

        <!--#region Menü  Reporting View-->
        <UI:MenuBar
            Grid.Row="0"
            Grid.ColumnSpan="2"
            ButtonSpacing="2"
            Header="Reporting View"
            ItemPadding="8,2"
            ShowBorder="True">

            <UI:MenuButton
                Command="{Binding Path=GoBackCommand}"
                CommandParameter="{x:Static core:CommandButtons.GoBack}"
                Image="{StaticResource ResourceKey=IconGoBack}"
                ToolTipText="Zurück" />

            <UI:MenuBarSeparator />

            <UI:MenuButton
                UI:MenuBar.Dock="Left"
                Command="{Binding Path=PrintCommand}"
                Image="{StaticResource ResourceKey=IconPrintDocument}"
                ToolTipText="Drucken" />

            <UI:ZoomControl
                Margin="4,0,2,0"
                UI:MenuBar.Dock="Left"
                Background="#FFF3F3F3"
                Foreground="#FF202020"
                MaxValue="200"
                MinValue="25"
                Step="25"
                Value="{Binding Path=ZoomValue, Mode=TwoWay}" />
        </UI:MenuBar>

        <!--#endregion Menü  Reporting View-->

        <!--  Dokumentanzeige  -->
        <DocumentViewer
            x:Name="ReportViewer"
            Grid.Row="1"
            Document="{Binding Path=Document}"
            MaxPagesAcross="1"
            Template="{StaticResource ResourceKey=DocumentViewerNoToolbarTemplate}"
            Zoom="{Binding Path=ZoomValue, Mode=TwoWay}" />

    </Grid>
</base:UserControlBase>
